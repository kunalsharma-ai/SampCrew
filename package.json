{
  "name": "crew",
  "private": true,
  "version": "0.1.0",
  "description": "CREW by SAMPLEDGE: one intelligent platform for your entire workforce",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @crew/contracts --filter @crew/db --filter @crew/ui run build",
    "build": "pnpm build:packages && pnpm --filter @crew/api --filter @crew/web --filter @crew/console run build",
    "dev:api": "pnpm --filter @crew/api dev",
    "dev:web": "pnpm --filter @crew/web dev",
    "dev:console": "pnpm --filter @crew/console dev",
    "db:migrate": "pnpm --filter @crew/db migrate",
    "db:seed": "pnpm --filter @crew/db seed",
    "db:reset": "pnpm --filter @crew/db reset",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "docs:permissions": "pnpm --filter @crew/contracts run docs:permissions",
    "e2e:web": "node e2e/web-smoke.cjs",
    "e2e:console": "node e2e/console-smoke.cjs",
    "e2e:hr": "node e2e/hr-flow.cjs",
    "e2e:attendance": "node e2e/attendance-flow.cjs",
    "e2e:recruitment": "node e2e/recruitment-flow.cjs",
    "e2e:payroll": "node e2e/payroll-flow.cjs",
    "e2e:talent": "node e2e/talent-flow.cjs",
    "e2e:mobile": "node e2e/mobile-flow.cjs",
    "e2e:helpdesk": "node e2e/helpdesk-flow.cjs",
    "e2e:ai": "node e2e/ai-flow.cjs",
    "e2e:integrations": "node e2e/integrations-flow.cjs",
    "e2e:enterprise": "node e2e/enterprise-flow.cjs",
    "e2e:experience": "node e2e/experience-flow.cjs",
    "e2e:directory": "node e2e/directory-flow.cjs",
    "e2e:bids": "node e2e/bids-flow.cjs",
    "e2e:universe": "node e2e/universe-flow.cjs",
    "e2e:ats": "node e2e/ats-flow.cjs",
    "load-test": "node e2e/load.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "otplib": "12.0.1",
    "playwright": "1.63.0"
  }
}
