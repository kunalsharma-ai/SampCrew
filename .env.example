# ---------------------------------------------------------------------------
# CREW environment template. Copy to .env and fill in. Never commit real secrets.
# In staging/production these come from the secret manager, not files.
# ---------------------------------------------------------------------------
CREW_ENV=local                       # local | test | staging | production
NODE_ENV=development

# Database: migrations/seed use the owner URL; the API uses the restricted crew_api login.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/crew
DATABASE_API_PASSWORD=change-me-local-only
DATABASE_URL=postgres://crew_api:change-me-local-only@localhost:5432/crew
DATABASE_POOL_MAX=20

REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CONSOLE_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_PLATFORM_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key (base64) for encrypting MFA secrets and other field-level secrets. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Email, AI, push, virus scanning and mobile sign-in addresses are normally set up in the Super Admin Console
# (Integrations), with no restart. The variables below are only a fallback, used while nothing is saved there.
# ---------------------------------------------------------------------------
# Email. Leave SMTP_URL empty to keep emails in the database without sending them (shown as "not delivered").
# Local: run Mailpit from infra/docker and use smtp://localhost:1025 (web UI on http://localhost:8025).
SMTP_URL=
MAIL_FROM=CREW <no-reply@crew.local>

# Uploaded files (local storage driver). Object storage (S3/R2/MinIO) is not wired up yet.
STORAGE_DIR=./.data/files
# Optional: secret for signing download links (defaults to a key derived from FIELD_ENCRYPTION_KEY)
FILE_URL_SECRET=

# First SAMPLEDGE Super Admin (created by `pnpm db:seed` only if none exists)
CREW_BOOTSTRAP_ADMIN_EMAIL=
CREW_BOOTSTRAP_ADMIN_PASSWORD=

# AI (Phase 8). Off by default: with AI_PROVIDER=none no data is sent to any AI service.
# To use the Claude API set AI_PROVIDER=anthropic and your own ANTHROPIC_API_KEY (never commit it).
AI_PROVIDER=none
ANTHROPIC_API_KEY=
# Optional: a regional gateway, or the local test stub (http://localhost:4010) used by e2e/ai-flow.cjs
ANTHROPIC_BASE_URL=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
# When the model declines a request, retry it once on the provider's fallback model (true/false)
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT_MS=30000

# Integrations (Phase 9). Webhooks and Slack refuse private and local network addresses. Set true only for local
# development and tests (refused in staging and production).
INTEGRATIONS_ALLOW_PRIVATE_URLS=false
# Test only: send Slack calls to a local stub instead of https://hooks.slack.com (e2e/integrations-flow.cjs uses
# http://localhost:4020). Refused in staging and production.
SLACK_WEBHOOK_BASE_URL=

# Single sign-on in the mobile app (Phase 11): the app addresses the Web Portal may send a finished sign-in back to,
# comma-separated. crew://sso is the iOS and Android app; add http://localhost:8081/sso for the browser preview.
MOBILE_SSO_REDIRECTS=crew://sso
# Redis for rate-limit counters shared by all API servers (Phase 11). Needed when running more than one API replica;
# without it each server counts on its own. Example: redis://localhost:6379/0
REDIS_URL=

# Demo tenant for local development (all users share this password)
CREW_SEED_DEMO=true
CREW_DEMO_PASSWORD=

# Web / console (server-side only)
CREW_API_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false
