# ---------------------------------------------------------------------------
# SampCrew environment template. Copy to .env and fill in. Never commit real secrets.
# This file holds only what SampCrew needs before it can reach its database: the database (and Redis) connection, and
# addresses and limits. Every API key and secret, and the key that encrypts them, lives in the database (see below).
# ---------------------------------------------------------------------------
CREW_ENV=local                       # local | test | staging | production
NODE_ENV=development

# Database: MongoDB 8.0 as a replica set (transactions need one; infra/docker/docker-compose.yml starts a single-node
# one) or a MongoDB Atlas cluster. The path names the database. See docs/ops/mongodb.md.
MONGODB_URL=mongodb://localhost:27017/crew?replicaSet=rs0
MONGODB_POOL_MAX=20

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CONSOLE_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# ---------------------------------------------------------------------------------------------------------------
# No API keys here. Email (SMTP), Claude AI, mobile push, virus scanning, mobile sign-in addresses, Razorpay, Stripe
# and off-site backup storage are entered in the Super Admin Console > Integrations and kept in the database,
# encrypted. Workspace integrations (Slack, webhooks, single sign-on, API keys) are set in each workspace's Settings.
# The encryption key that locks those saved keys, and the sign-in signing keys, are created by the API itself on its
# first start and also kept in the database, so a copy of the database or of a backup can open them: protect both
# like the keys themselves (backups are locked with BACKUP_PASSPHRASE).
# Upgrading from an older release that had FIELD_ENCRYPTION_KEY, SMTP_URL, ANTHROPIC_API_KEY, JWT_*_SECRET and the like
# here: start once, and they are moved into the database (the API log and the Console list the lines to delete).
# ---------------------------------------------------------------------------------------------------------------

# Uploaded files (local storage driver). Object storage (S3/R2/MinIO) is not wired up yet.
STORAGE_DIR=./.data/files

# First SAMPLEDGE Super Admin. Normally left empty: open the Console and create it with the one-time setup code the API
# prints in its log ("SampCrew is not set up yet"). Set both only for automated installs and tests (`pnpm db:seed`).
# Locked out? `pnpm db:admin reset-mfa --email ...` (see docs/ops/console-admins.md).
CREW_BOOTSTRAP_ADMIN_EMAIL=
CREW_BOOTSTRAP_ADMIN_PASSWORD=

# Local development and tests only (refused in staging and production): let webhooks, Slack and identity providers
# use private and local network addresses, and send Slack calls to a local stub (e2e/integrations-flow.cjs uses
# http://localhost:4020) instead of https://hooks.slack.com.
INTEGRATIONS_ALLOW_PRIVATE_URLS=false
SLACK_WEBHOOK_BASE_URL=

# Redis for rate-limit counters shared by all API servers (Phase 11). Needed when running more than one API replica;
# without it each server counts on its own. Example: redis://localhost:6379/0
REDIS_URL=

# Demo tenant for local development (all users share this password)
CREW_SEED_DEMO=true
CREW_DEMO_PASSWORD=

# Web / console (server-side only)
CREW_API_URL=http://localhost:4000
SESSION_COOKIE_SECURE=false
