{
  "name": "@crew/api",
  "version": "0.1.0",
  "private": true,
  "description": "SampCrew API: NestJS modular monolith",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mongo": "vitest run -c vitest.mongo.config.ts",
    "openapi": "node dist/openapi-export.js > ../../docs/api/openapi.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@crew/contracts": "workspace:*",
    "@crew/db": "workspace:*",
    "@fontsource/noto-sans": "5.2.10",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "mongodb": "7.7.0",
    "nodemailer": "8.0.11",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "regenerator-runtime": "0.14.1",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.10",
    "@types/supertest": "7.2.1",
    "smtp-server": "3.13.6",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
