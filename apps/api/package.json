  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@crew/contracts": "workspace:*",
    "@crew/db": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "nodemailer": "6.10.1",
    "otplib": "12.0.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.10",
    "@types/supertest": "7.2.1",
    "smtp-server": "3.13.6",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
