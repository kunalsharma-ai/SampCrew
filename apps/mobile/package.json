{
  "name": "@crew/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CREW mobile app (Expo, React Native) for employees and managers: attendance with an offline queue, leave, payslips, approvals, helpdesk and announcements",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist-web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@crew/contracts": "workspace:*",
    "@expo/metro-runtime": "57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.30",
    "expo-application": "57.0.3",
    "expo-constants": "57.0.22",
    "expo-crypto": "57.0.4",
    "expo-device": "57.0.2",
    "expo-linking": "57.0.13",
    "expo-local-authentication": "57.0.3",
    "expo-location": "57.0.21",
    "expo-notifications": "57.0.23",
    "expo-router": "57.0.28",
    "expo-screen-capture": "57.0.4",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
