# ---------------------------------------------------------------------------------------------------------------
# CREW production settings for infra/deploy/compose.yml. Copy to infra/deploy/.env, then append fresh secrets:
#   cp env.production.example .env && ./gen-secrets.sh >> .env && chmod 600 .env
# Never commit .env. On a platform with a secret manager, put the generated values there instead.
# The API refuses to start in staging or production with plain-http addresses, localhost origins or template
# secrets, so a half-filled file fails loudly instead of running unsafely.
# ---------------------------------------------------------------------------------------------------------------
CREW_ENV=production
# Image tag to run (the tag you built and pushed, e.g. a git commit). "local" builds on this host.
CREW_VERSION=local
CREW_IMAGE_PREFIX=crew

# --- Addresses (DNS for all three must point at this host) ------------------------------------------------------
CREW_WEB_ADDRESS=crew.example.com
CREW_API_ADDRESS=api.crew.example.com
CREW_CONSOLE_ADDRESS=console.crew.example.com
# Who may open the Super Admin Console (space-separated IPs or ranges). Default: private networks only (VPN).
CONSOLE_ALLOWED_IPS=private_ranges
# For Let's Encrypt expiry notices
ACME_EMAIL=ops@example.com

WEB_PUBLIC_URL=https://crew.example.com
API_PUBLIC_URL=https://api.crew.example.com
CONSOLE_PUBLIC_URL=https://console.crew.example.com
CORS_ORIGINS=https://crew.example.com,https://console.crew.example.com
# The iOS / Android app's return address after single sign-on
MOBILE_SSO_REDIRECTS=crew://sso

# --- Database ---------------------------------------------------------------------------------------------------
POSTGRES_DB=crew
# Bundled PostgreSQL by default. For a managed database set its host here (and see compose.yml).
DATABASE_HOST=postgres
DATABASE_POOL_MAX=20

# --- First SAMPLEDGE Super Admin (created once, on the first start; enrol two-step verification at first sign-in) -
CREW_BOOTSTRAP_ADMIN_EMAIL=
CREW_BOOTSTRAP_ADMIN_PASSWORD=
# Demo data is refused in production.
CREW_SEED_DEMO=false

# --- Email (needed for invitations, password resets and notifications) -----------------------------------------
# smtps://user:password@smtp.example.com:465  Without it, emails are kept and shown as "not delivered".
SMTP_URL=
MAIL_FROM=CREW <no-reply@example.com>

# --- Optional providers (off until you add real keys) ---------------------------------------------------------------
AI_PROVIDER=none
ANTHROPIC_API_KEY=
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# Virus scanning of uploads: start ClamAV with `docker compose --profile scan up -d`, then set
# CLAMAV_URL=tcp://clamav:3310. Uploads are refused while it is set and ClamAV is down.
CLAMAV_URL=

# --- Limits and backups -------------------------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# --- Field encryption key rotation (docs/ops/runbook.md, "Secrets"): the old key, only while rotating ----------------
FIELD_ENCRYPTION_KEYS_PREVIOUS=

# --- Secrets: append with ./gen-secrets.sh >> .env ----------------------------------------------------------------
