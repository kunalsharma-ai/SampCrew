# ---------------------------------------------------------------------------------------------------------------
# SampCrew production settings for infra/deploy/compose.yml. Copy to infra/deploy/.env, then append fresh secrets:
#   cp env.production.example .env && ./gen-secrets.sh >> .env && chmod 600 .env
# Never commit .env. On a platform with a secret manager, put the generated values there instead.
# The API refuses to start in staging or production with plain-http addresses, localhost origins or template
# secrets, so a half-filled file fails loudly instead of running unsafely.
# ---------------------------------------------------------------------------------------------------------------
CREW_ENV=production
# Image tag to run (the tag you built and pushed, e.g. a git commit). "local" builds on this host.
CREW_VERSION=local
CREW_IMAGE_PREFIX=crew

# --- Addresses (DNS for all three must point at this host) ------------------------------------------------------
CREW_WEB_ADDRESS=crew.example.com
CREW_API_ADDRESS=api.crew.example.com
CREW_CONSOLE_ADDRESS=console.crew.example.com
# Who may open the Super Admin Console (space-separated IPs or ranges). Default: private networks only (VPN).
CONSOLE_ALLOWED_IPS=private_ranges
# For Let's Encrypt expiry notices
ACME_EMAIL=ops@example.com

WEB_PUBLIC_URL=https://crew.example.com
API_PUBLIC_URL=https://api.crew.example.com
CONSOLE_PUBLIC_URL=https://console.crew.example.com
CORS_ORIGINS=https://crew.example.com,https://console.crew.example.com
# The iOS / Android app's return address after single sign-on
MOBILE_SSO_REDIRECTS=crew://sso

# --- Database: self-hosted MongoDB 8.0 replica set on this server (default) ---------------------------------------
# Leave both URLs empty: compose.yml runs MongoDB with authentication, its users come from gen-secrets.sh, and the
# migration job creates the API's own user (crew_api) and the point-in-time backup user (crew_pbm).
MONGODB_URL=
MONGODB_ADMIN_URL=
MONGODB_POOL_MAX=20
# Pin the exact MongoDB release you tested (see docs/ops/mongodb.md, "Upgrading MongoDB"), e.g. mongo:8.0.38
MONGO_IMAGE=mongo:8.0
# WiredTiger cache in GB. Empty = MongoDB's default (half the memory minus 1 GB), too much when the apps share the
# host: 2 suits the 8 GB host in the runbook; give the database about a quarter to a third of the memory.
MONGO_CACHE_SIZE_GB=2
# The address this member announces in the replica set. Keep the default unless you will add members on other
# servers: then set a DNS name they can reach (e.g. db1.crew.internal:27017) BEFORE the first start.
MONGO_REPLICA_HOST=mongo:27017
# Point-in-time backups (pbm service): a base backup every PBM_BASE_BACKUP_HOURS, every change saved in slices of
# PBM_OPLOG_SPAN_MIN minutes, kept PBM_KEEP_DAYS days. Restore to any second in that window: docs/ops/mongodb.md.
PBM_BASE_BACKUP_HOURS=24
PBM_OPLOG_SPAN_MIN=10
PBM_KEEP_DAYS=14
#
# Optional, MongoDB Atlas instead (managed): set both URLs, delete the MONGODB_API_PASSWORD and MONGODB_PBM_PASSWORD
# lines that gen-secrets.sh adds, and start with --scale mongo=0 --scale pbm=0 (docs/ops/mongodb.md, "MongoDB Atlas").
#   MONGODB_URL        the API's user: readWrite on the crew database (add clusterMonitor for the Console's health page)
#   MONGODB_ADMIN_URL  migrations and backups: a user that can create collections and indexes and read everything
#   e.g. mongodb+srv://crew-api:...@crew.xxxxx.mongodb.net/crew

# --- First SAMPLEDGE Super Admin (created once, on the first start; enrol two-step verification at first sign-in) -
# Afterwards change the password in the Console, delete the password line here, and add colleagues in Console >
# Console admins. Nobody can sign in? scripts/admin.sh (docs/ops/console-admins.md).
CREW_BOOTSTRAP_ADMIN_EMAIL=
CREW_BOOTSTRAP_ADMIN_PASSWORD=
# Demo data is refused in production.
CREW_SEED_DEMO=false

# --- Integrations: set these up in the Super Admin Console > Integrations instead ---------------------------------
# Email, Claude AI, mobile push and virus scanning are configured, tested and switched on from the Console after the
# first sign-in, with no restart. Leave everything below empty unless you want a fallback that applies while nothing
# is saved in the Console (a value saved there always wins).
# smtps://user:password@smtp.example.com:465  Without email, messages are kept and shown as "not delivered".
SMTP_URL=
MAIL_FROM=SampCrew <no-reply@example.com>

AI_PROVIDER=none
ANTHROPIC_API_KEY=
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# Virus scanning of uploads: start ClamAV with `docker compose --profile scan up -d`, then set
# CLAMAV_URL=tcp://clamav:3310. Uploads are refused while it is set and ClamAV is down.
CLAMAV_URL=

# --- Limits and backups -------------------------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=600
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Off-site copy of the archives and point-in-time backups (strongly recommended). An rclone remote and path; the
# storage account itself goes in offsite.env (copy offsite.env.example). Empty = backups stay on this server only.
BACKUP_REMOTE=
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_SYNC_MINUTES=15
# Posted {"text": "..."} when a backup or its off-site copy fails (a Slack, Teams or Google Chat incoming webhook).
BACKUP_ALERT_WEBHOOK=

# --- Field encryption key rotation (docs/ops/runbook.md, "Secrets"): the old key, only while rotating ----------------
FIELD_ENCRYPTION_KEYS_PREVIOUS=

# --- Secrets: append with ./gen-secrets.sh >> .env ----------------------------------------------------------------
