# ---------------------------------------------------------------------------------------------------------------
# Off-site backup storage for the backup service (compose.yml). Copy to infra/deploy/offsite.env, fill in ONE of the
# blocks below, set BACKUP_REMOTE in .env, and `chmod 600 offsite.env`. Never commit offsite.env.
# Only the backup service reads this file. Every RCLONE_CONFIG_OFFSITE_* setting is an rclone option for a remote
# called "offsite": https://rclone.org/docs/#config-file and the page for your provider.
# Use a bucket of its own, with versioning on (and object lock / retention if your provider has it), and a key that
# can only write to that bucket.
# Test it: docker compose run --rm backup rclone lsd offsite:   then a backup: docker compose run --rm backup /app/infra/deploy/scripts/backup.sh
# ---------------------------------------------------------------------------------------------------------------

# --- Amazon S3 (BACKUP_REMOTE=offsite:your-bucket/sampcrew) -----------------------------------------------------
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_REGION=ap-south-1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# Required by buckets that refuse public ACLs (the default for new S3 buckets)
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# --- Other S3-compatible storage: Backblaze B2, Wasabi, Cloudflare R2, DigitalOcean Spaces, MinIO ----------------
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# --- Azure Blob Storage (BACKUP_REMOTE=offsite:container/sampcrew) ----------------------------------------------
# RCLONE_CONFIG_OFFSITE_TYPE=azureblob
# RCLONE_CONFIG_OFFSITE_ACCOUNT=
# RCLONE_CONFIG_OFFSITE_KEY=

# --- Another server over SFTP (BACKUP_REMOTE=offsite:/srv/backups/sampcrew) -------------------------------------
# RCLONE_CONFIG_OFFSITE_TYPE=sftp
# RCLONE_CONFIG_OFFSITE_HOST=backup.example.com
# RCLONE_CONFIG_OFFSITE_USER=sampcrew
# RCLONE_CONFIG_OFFSITE_KEY_PEM=   (the private key on one line, newlines as \n)
